# Copy this file to .env and fill in the values.

# ---- How sign-in codes are sent ----
# email (default): users sign in with their email address
# sms: users sign in with their Ethiopian mobile number (GeezSMS)
OTP_MEDIUM=email

# ---- Email / SMTP (required when OTP_MEDIUM=email) ----
SMTP_HOST=
# 587 (STARTTLS) or 465 (SSL)
SMTP_PORT=587
# true for port 465, false for 587 (optional; guessed from the port)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown to users, e.g. MCE Feasibility <no-reply@yourdomain.com>
SMTP_FROM=

# ---- GeezSMS (required when OTP_MEDIUM=sms) ----
# Your API key / access token from the GeezSMS dashboard. Paste it here:
GEEZSMS_API_KEY=
# Optional: approved sender ID / name shown on the SMS
GEEZSMS_SENDER_ID=

# ---- Security ----
# Long random string used when hashing one-time codes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Password for the sign-in log popup (Ctrl + Alt + R on the main page)
ADMIN_PASSWORD=

# How long a login lasts before the user must sign in again (days)
SESSION_DAYS=7

# ---- Supabase database (required) ----
# Supabase dashboard -> Connect -> "Transaction pooler" connection string (port 6543),
# with [YOUR-PASSWORD] replaced by your database password.
DATABASE_URL=
